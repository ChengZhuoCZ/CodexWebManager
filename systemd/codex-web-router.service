[Unit]
Description=Upstream 0xcaff/codex-web with account-router model path
After=network-online.target tailscaled.service codex-web-router-app-server.service
Wants=network-online.target codex-web-router-app-server.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/srv/codex-workspaces
Environment=NODE_ENV=production
Environment=HOME=/var/lib/codex-web-router
Environment=CODEX_HOME=/var/lib/codex-web-router
Environment=CODEX_CLI_PATH=/opt/0xcaff-codex-web-router/bin/codex-remote-proxy-fast.mjs
Environment=CODEX_REAL_CLI_PATH=/usr/local/bin/codex
Environment=CODEX_UNIX_SOCKET=/run/codex-web-router-app-server/app-server.sock
ExecStart=/usr/bin/node /opt/0xcaff-codex-web-router/current/src/server/main.js --host 127.0.0.1 --port 8216
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=codex-web-router
StateDirectoryMode=0700
ReadWritePaths=/srv/codex-workspaces /var/lib/codex-web-router
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-web-router

[Install]
WantedBy=multi-user.target
