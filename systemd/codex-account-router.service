[Unit]
Description=Codex Account Router
Documentation=file:/opt/codex-account-router/current/share/doc/codex-account-router/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=codex
Group=codex
LimitCORE=0
WorkingDirectory=/var/lib/codex-account-router
ExecStart=/opt/codex-account-router/current/bin/codex-account-router
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
StateDirectory=codex-account-router
StateDirectoryMode=0700
RuntimeDirectory=codex-account-router
RuntimeDirectoryMode=0700
LoadCredential=admin-token:/etc/codex-account-router/credentials/admin-token
ImportCredential=codex-account-router.auth.*
Environment=CODEX_ROUTER_ADMIN_HOST=127.0.0.1
Environment=CODEX_ROUTER_ADMIN_PORT=18318
Environment=CODEX_ROUTER_MODEL_HOST=127.0.0.1
Environment=CODEX_ROUTER_MODEL_PORT=18317
Environment=CODEX_ROUTER_ACCOUNTS_FILE=/etc/codex-account-router/accounts.json
Environment=CODEX_ROUTER_CREDENTIAL_ROOT=%d
Environment=CODEX_ROUTER_ADMIN_TOKEN_FILE=%d/admin-token
Environment=CODEX_ROUTER_STATE_DIRECTORY=/var/lib/codex-account-router
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-account-router

[Install]
WantedBy=codex-stack.target
